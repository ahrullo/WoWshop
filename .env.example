# Скопируйте этот файл в .env и заполните значения.

# Connection string облачной базы Postgres (Neon: neon.tech -> Dashboard -> Connect -> Prisma).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Пароль для входа в панель администратора (/admin).
ADMIN_PASSWORD="wowshop123"

# Базовый URL сайта. Для локальной разработки — localhost, для продакшена — ваш домен.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Ключи Stripe (Developers -> API keys в дашборде Stripe). Пока STRIPE_SECRET_KEY пустой —
# оформление заказа работает в демо-режиме (без реальной оплаты).
STRIPE_SECRET_KEY=""
# Секрет вебхука (Developers -> Webhooks -> Add endpoint, или `stripe listen`).
STRIPE_WEBHOOK_SECRET=""
# Публикуемый ключ (понадобится, если добавите Stripe Elements на клиенте).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
